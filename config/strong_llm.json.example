{
  "provider": "openai",
  "model": "gpt-4",
  "api_key": "YOUR_API_KEY_HERE",
  "base_url": "https://api.openai.com/v1",
  "max_tokens": 4096,
  "temperature": 0.3,
  "timeout_seconds": 60,
  "retry": {
    "max_attempts": 3,
    "backoff_base_seconds": 2,
    "retryable_errors": [
      "rate_limit_exceeded",
      "timeout",
      "service_unavailable",
      "overloaded_error"
    ]
  }
}
